<UserControl x:Class="ScreenBoxDrawer.CaptureToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="True">
    <Border Padding="8"
            Background="#FFF8F8F8"
            BorderBrush="#55000000"
            BorderThickness="1"
            CornerRadius="6">
        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="StatusTextBlock"
                       Text="Choose a markup tool"
                       VerticalAlignment="Center"
                       Foreground="#333333"
                       Margin="4,0,10,0"/>
            <Button x:Name="LineButton"
                    Content="Line"
                    Padding="12,6"
                    Margin="0,0,4,0"
                    Click="LineButton_Click"/>
            <Button x:Name="BoxButton"
                    Content="Box"
                    Padding="12,6"
                    Margin="0,0,4,0"
                    Click="BoxButton_Click"/>
            <Button x:Name="CircleButton"
                    Content="Circle"
                    Padding="12,6"
                    Margin="0,0,12,0"
                    Click="CircleButton_Click"/>
            <Button Content="Copy"
                    Padding="12,6"
                    Margin="0,0,4,0"
                    Click="CopyButton_Click"/>
            <Button Content="Close"
                    Padding="12,6"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Border>
</UserControl>
