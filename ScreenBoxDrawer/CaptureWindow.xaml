<Window x:Class="ScreenBoxDrawer.CaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScreenBoxDrawer"
        Title="ScreenBoxDrawer Capture"
        Icon="pack://application:,,,/Assets/screenboxdrawer.png"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="True"
        Background="Black"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <Grid x:Name="RootGrid"
          Background="Transparent"
          MouseLeftButtonDown="RootGrid_MouseLeftButtonDown"
          MouseMove="RootGrid_MouseMove"
          MouseLeftButtonUp="RootGrid_MouseLeftButtonUp">
        <Image x:Name="ScreenshotImage"
               Stretch="Fill"
               IsHitTestVisible="False"/>
        <Rectangle x:Name="DimLayer"
                   Fill="#99000000"
                   IsHitTestVisible="False"/>
        <Image x:Name="SelectedImage"
               Stretch="Fill"
               Visibility="Collapsed"
               Panel.ZIndex="10"
               IsHitTestVisible="False"/>
        <Rectangle x:Name="SelectionBorder"
                   Stroke="#FFFF2020"
                   StrokeThickness="2"
                   Visibility="Collapsed"
                   Panel.ZIndex="20"
                   IsHitTestVisible="False"/>
        <Canvas x:Name="MarkupCanvas"
                Panel.ZIndex="30"
                IsHitTestVisible="False"/>

        <local:CaptureToolbar x:Name="Toolbar"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Panel.ZIndex="100"
                Visibility="Collapsed">
        </local:CaptureToolbar>
    </Grid>
</Window>
