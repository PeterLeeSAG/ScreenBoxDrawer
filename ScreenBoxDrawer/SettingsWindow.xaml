<Window x:Class="ScreenBoxDrawer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenBoxDrawer Settings"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="ScreenBoxDrawer" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="Configure global shortcuts and on-screen boxes."
                       Foreground="#666666" Margin="0,4,0,0"/>
        </StackPanel>

        <GroupBox Grid.Row="1" Header="Shortcuts" Padding="12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Draw box" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <TextBox x:Name="DrawHotkeyBox" Grid.Row="0" Grid.Column="1"
                         IsReadOnly="True" Focusable="True" Padding="6"
                         PreviewKeyDown="DrawHotkeyBox_PreviewKeyDown" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="1" Text="Draw arrow" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <TextBox x:Name="ArrowHotkeyBox" Grid.Row="1" Grid.Column="1"
                         IsReadOnly="True" Focusable="True" Padding="6"
                         PreviewKeyDown="ArrowHotkeyBox_PreviewKeyDown" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="2" Text="Clear all boxes" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <TextBox x:Name="ClearHotkeyBox" Grid.Row="2" Grid.Column="1"
                         IsReadOnly="True" Focusable="True" Padding="6"
                         PreviewKeyDown="ClearHotkeyBox_PreviewKeyDown" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="3" Grid.ColumnSpan="2"
                           Text="Click a shortcut field and press a key combination. The draw shortcut arms the next left-button drag."
                           TextWrapping="Wrap" Foreground="#666666" FontSize="12"/>
                <CheckBox x:Name="DirectGestureCheckBox" Grid.Row="4" Grid.ColumnSpan="2"
                          Content="Enable Ctrl+Shift+drag direct drawing"
                          Margin="0,10,0,0"/>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="Boxes" Padding="12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Maximum visible boxes" VerticalAlignment="Center"/>
                <TextBox x:Name="MaximumBoxesTextBox" Grid.Column="1" Padding="6"
                         HorizontalContentAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="1" Text="Visible duration (seconds; 0 = unlimited)"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="BoxDisplaySecondsTextBox" Grid.Row="1" Grid.Column="1"
                         Padding="6" HorizontalContentAlignment="Center"/>
            </Grid>
        </GroupBox>

        <CheckBox x:Name="EffectsCheckBox" Grid.Row="3"
                  Content="Enable dashed and moving effects"
                  Margin="2,0,0,14"/>

        <StackPanel Grid.Row="4" Margin="0,0,0,12">
            <Button Content="Clear all boxes now" HorizontalAlignment="Left"
                    Padding="12,6" Click="ClearBoxes_Click"/>
            <TextBlock Text="Ctrl+Shift+drag also remains available for drawing."
                       Foreground="#666666" FontSize="12" Margin="0,8,0,0"/>
        </StackPanel>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ErrorTextBlock" Foreground="#B00020"
                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Grid.Column="1" Content="Cancel" MinWidth="84" Padding="12,6"
                    Margin="0,0,8,0" IsCancel="True"/>
            <Button Grid.Column="2" Content="Save" MinWidth="84" Padding="12,6"
                    IsDefault="True" Click="Save_Click"/>
        </Grid>
    </Grid>
</Window>
